{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "api.index:app",
      "functions": {
        "api/index.py": {
          "maxDuration": 300,
          "includeFiles": "{server.py,streamlit_app.py,ui/**,.streamlit/**}",
          "excludeFiles": "{backend/**,docs/**,eval/**,assets/**,scripts/**,data/**,db/**,ui/tests/**,.venv/**}"
        }
      },
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/api/index"
        }
      ],
      "bindings": [
        {
          "type": "service",
          "service": "analyst",
          "format": "url",
          "env": "ANALYST_INTERNAL_URL"
        }
      ]
    },
    "analyst": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "deploy/Dockerfile.api"
    }
  },
  "rewrites": [
    {
      "source": "/backend/(.*)",
      "destination": {
        "service": "analyst"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "redirects": [
    {
      "source": "/ask",
      "destination": "/?page=ask",
      "permanent": false
    },
    {
      "source": "/watchlist",
      "destination": "/?page=watchlist",
      "permanent": false
    },
    {
      "source": "/growth-payoff",
      "destination": "/?page=growth-payoff",
      "permanent": false
    },
    {
      "source": "/research",
      "destination": "/?page=research",
      "permanent": false
    },
    {
      "source": "/eval",
      "destination": "/?page=eval",
      "permanent": false
    },
    {
      "source": "/how-it-works",
      "destination": "/?page=how-it-works",
      "permanent": false
    }
  ]
}
