# Copy to .env and fill in. Never commit .env.
# Supabase Postgres connection string (Project settings -> Database -> Connection string, URI)
SUPABASE_DB_URL=
# Local throwaway database for backend/tests/test_ingest_db.py; must be localhost AND not your dev database
# (the test drops the quantrag schema), e.g. postgresql://postgres:pg@localhost:5433/quantrag_test
TEST_DATABASE_URL=
# Gemini (answers). Model IDs change: check the provider's model list and set GEMINI_MODEL; never hard-code it.
# gemini-3.1-flash-lite: listed as stable (not preview) on ai.google.dev/gemini-api/docs/models, 2026-10-15 (D29).
# Final choice is made on the Phase 6 gold set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# false = Phase 6 ablation: every question routed as "single" with no company/period filter
ROUTER_ENABLED=true
# Refuse when the best rerank score is below this. Tuned in Phase 6; leave empty until then.
REFUSAL_MIN_RERANK=
# Local development leaves APP_ENV=development; production requires a shared server-only token.
APP_ENV=development
API_ACCESS_TOKEN=
# Total requests/day; each thesis period consumes one unit. Failed attempts consume their reservation.
DAILY_REQUEST_LIMIT=100
# Use a persistent mounted directory for restart-persistent budgets. /tmp resets on redeploy.
USAGE_DB_PATH=/tmp/quantrag-usage.sqlite3
# Offline evaluation: explicit non-Gemini judge, e.g. an OpenAI-compatible endpoint.
JUDGE_API_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_FAMILY=
# Optional explicitly chosen Gemini fallback; empty keeps both attempts on the primary.
# Fallback is not quality-validated automatically and may have different pricing.
GEMINI_FALLBACK_MODEL=
