#!/bin/sh
# Blocks a push if gitleaks finds a possible secret in the commits being pushed.
# Install once per clone:  brew install gitleaks && git config core.hooksPath .githooks
# Fails closed: if gitleaks is missing, the push is blocked rather than let through unscanned.
command -v gitleaks >/dev/null 2>&1 || {
  echo "pre-push: gitleaks is not installed (brew install gitleaks); push blocked." >&2; exit 1; }
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                      # deleting a remote branch: nothing to scan
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"   # new branch: commits not on any remote
  else range="$remote_sha..$local_sha"; fi
  if ! gitleaks git --no-banner --redact --log-opts="$range" .; then
    echo "pre-push: gitleaks found possible secrets in $local_ref ($range); push blocked." >&2
    echo "pre-push: remove the secret from history, rotate it if it was real, then push again." >&2
    exit 1
  fi
done
exit 0
